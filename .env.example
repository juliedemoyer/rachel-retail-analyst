# Copy this file to .env.local for local dev, and set the same keys in your
# Vercel project's Environment Variables. Never commit .env.local — it is
# gitignored.
#
# Nothing here is required to try the app: run `npm run dev` and open
# /app?demo=1 for the full UI with fictional data and no backend at all.

# ── Required for a real instance ───────────────────────────────────────────

# Anthropic API key. Powers extraction, Ask, and pulse synthesis.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Upstash Redis — all application state (profiles, snapshots, pulse,
# candidates, token log). Add the integration from your Vercel Storage tab.
UPSTASH_URL=
UPSTASH_TOKEN=

# Upstash Vector — the knowledge base index. Create an index at
# console.upstash.com/vector with a server-side embedding model configured
# (mxbai-embed-large-v1 or equivalent), so no local embedding call is needed.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Vercel Blob — raw PDF storage for ingested filings.
# Auto-provisioned on Vercel; for local dev run `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Shared secret the cron endpoints check. Set this, or anyone who guesses
# /api/cron?job=ir-scrape can run your ingestion jobs.
CRON_SECRET=

# ── Identity ───────────────────────────────────────────────────────────────

# Public base URL of your deployment. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Google Search Console ownership token, if you verify the domain there.
# Leave unset and no verification meta tag is emitted.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Overrides config/profile.json -> ownerName for outbound email signatures.
# Useful if you fork this publicly but don't want your name in the repo.
OWNER_NAME=

# Email address that gets admin access.
ADMIN_EMAIL=
# Clerk userId for that same account, used by the per-user guards.
OWNER_USER_ID=
# Where signup requests and cron summaries are sent.
NOTIFY_EMAIL=

# ── Optional: Clerk auth ───────────────────────────────────────────────────
# Install from the Vercel Marketplace or grab keys at dashboard.clerk.com.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# ── Optional: transactional email (Resend) ─────────────────────────────────
# Leave unset and no email is ever sent. See docs/EMAILS.md.
RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_REPLY_TO=

# ── Optional: external sprint/task board ───────────────────────────────────
# If set, cross-agent tasks are POSTed to {SPRINT_BOARD_URL}/api/tasks and job
# runs are reported to /api/sprints. Leave unset and every call is a no-op.
SPRINT_BOARD_URL=
DASHBOARD_SECRET=

# ── Optional: model tuning ─────────────────────────────────────────────────
# Pin the model used by ir-extract (defaults to a Haiku-class model).
EXTRACT_MODEL=
# Force Ask to use Sonnet. Escape valve if answer quality regresses.
ASK_RACHEL_FORCE_SONNET=
# Opt-in deep-analysis tier for sector-wide questions (ranking the whole
# watchlist, multi-company multi-quarter synthesis). Leave unset and the
# router stays strictly Haiku + Sonnet, which is the cheap default.
# Example: DEEP_ANALYSIS_MODEL=claude-opus-4-6
DEEP_ANALYSIS_MODEL=
# Route the nightly extraction through the Message Batches API (~50% cheaper).
IR_EXTRACT_USE_BATCH=

# ── Optional: reranking (pick one, or neither) ─────────────────────────────
# COHERE_API_KEY=
# VOYAGE_API_KEY=

# ── Optional: analytics and error monitoring (no-op if unset) ──────────────
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Optional: local sync scripts only (not needed on Vercel) ───────────────
# If you keep a personal Markdown notes vault and want scripts/sync-*.ts to
# read from it, point these at it. Leave unset and those scripts no-op.
# VAULT_DIR=/path/to/vault/daily-notes
# DOMAIN_DIR=/path/to/vault/domain-brain
# SHARED_SOURCES_PATH=/path/to/vault/shared_sources.md
